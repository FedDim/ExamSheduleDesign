<UserControl x:Class="ExamSheduleDesign.Controls.NotificationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Width="300" Height="Auto">
    <UserControl.Resources>
        <Storyboard x:Key="ShowAnimation">
            <ThicknessAnimation Storyboard.TargetProperty="Margin"
                                From="0,0,-320,0" To="0,0,0,0"
                                Duration="0:0:0.3"
                                DecelerationRatio="0.8"/>
        </Storyboard>
        <Storyboard x:Key="HideAnimation">
            <ThicknessAnimation Storyboard.TargetProperty="Margin"
                                From="0,0,0,0" To="0,0,-320,0"
                                Duration="0:0:0.3"
                                DecelerationRatio="0.8">
                <ThicknessAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </ThicknessAnimation.EasingFunction>
            </ThicknessAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Border Background="{StaticResource CardBackgroundBrush}"
            CornerRadius="8"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="0,0,0,3"
            Effect="{StaticResource CardShadow}"
            Padding="12,8">
        <StackPanel Orientation="Horizontal">
            <!-- Иконка в зависимости от типа (пока заглушка) -->
            <iconPacks:PackIconModern Kind="Information" Width="20" Height="20" Foreground="{StaticResource AccentBrush}" Margin="0,0,12,0"/>
            <TextBlock x:Name="MessageText" Text="{Binding Message}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="13" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</UserControl>