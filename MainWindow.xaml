<metro:MetroWindow x:Class="ExamSheduleDesign.MainWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:metro="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                   xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                   xmlns:views="clr-namespace:ExamSheduleDesign.Views"
                   xmlns:controls="clr-namespace:ExamSheduleDesign.Controls"
                   Title="Генератор расписания экзаменов"
                   Width="1200" Height="800"
                   MinWidth="800" MinHeight="700"
                   WindowStartupLocation="CenterScreen"
                   Background="{StaticResource WindowBackgroundBrush}"
                   GlowBrush="{DynamicResource MahApps.Brushes.Accent}">

    <metro:MetroWindow.Resources>
        <Storyboard x:Key="PageTransition">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="15" To="0" Duration="0:0:0.15"/>
        </Storyboard>
    </metro:MetroWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Навигация -->
        <views:NavigationBar Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" x:Name="NavigationBarControl"/>

        <!-- Хлебные крошки (вместо поиска) -->
        <Border Grid.Column="1" Grid.Row="0" Background="{StaticResource CardBackgroundBrush}" Padding="12,8" CornerRadius="12,12,0,0"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Расписание экзаменов / " Foreground="{StaticResource SecondaryTextBrush}"/>
                <TextBlock Text="{Binding Breadcrumb}" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <controls:NotificationControl x:Name="NotificationToast"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              Margin="0,60,20,0"
                              Visibility="Collapsed"/>

        <!-- Контентная область -->
        <Border x:Name="ContentBorder"
                Grid.Column="1" Grid.Row="1"
                Background="{StaticResource CardBackgroundBrush}"
                CornerRadius="{StaticResource ContentAreaCornerRadius}"
                Margin="2,0,0,0">
            <Grid>
                <ContentControl x:Name="MainContentArea" Content="{Binding CurrentPage}">
                    <ContentControl.RenderTransform>
                        <TranslateTransform X="0"/>
                    </ContentControl.RenderTransform>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="ContentChanged">
                            <i:ControlStoryboardAction Storyboard="{StaticResource PageTransition}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </ContentControl>
            </Grid>
        </Border>
    </Grid>
</metro:MetroWindow>