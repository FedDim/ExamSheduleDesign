<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="SuccessBrush" Color="#2E7D32"/>

    <!-- === Фоны (три разных оттенка) === -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#EAECF0"/><!-- фон окна -->
    <SolidColorBrush x:Key="NavBackgroundBrush" Color="#FFFFFF"/><!-- боковая панель -->
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#F6F8FA"/><!-- контентная область -->

    <!-- === Базовые цвета (из референса) === -->
    <Color x:Key="AccentColor">#0078D4</Color>
    <Color x:Key="PrimaryTextColor">#1A1A1A</Color>
    <Color x:Key="SecondaryTextColor">#5C5C5C</Color>
    <Color x:Key="BorderColor">#E0E0E0</Color>
    <Color x:Key="HoverBackgroundColor">#F0F0F0</Color>
    <Color x:Key="SelectedBackgroundColor">#E6F2FB</Color>

    <!-- === Кисти для текста === -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />

    <!-- === Кисти для границ === -->
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />

    <!-- === Эффекты === -->
    <DropShadowEffect x:Key="CardShadow" BlurRadius="8" ShadowDepth="2" Opacity="0.12" />

    <!-- === Скругления === -->
    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="NavBarCornerRadius">0,12,12,0</CornerRadius>
    <CornerRadius x:Key="ContentAreaCornerRadius">12,0,0,12</CornerRadius>

    <!-- Кисть акцентного цвета -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>

    <!-- Стиль карточки -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}"/>
        <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- Стиль DataGrid (базовый) -->
    <Style x:Key="DataGridStyle" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="GridLinesVisibility" Value="None"/>
        <Setter Property="RowBackground" Value="Transparent"/>
        <Setter Property="AlternatingRowBackground" Value="#F9F9F9"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RowHeight" Value="40"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
    </Style>

    <!-- Стиль ячейки DataGrid -->
    <Style x:Key="DataGridCellStyle" TargetType="DataGridCell">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>

    <!-- Кисти (если ещё не определены) -->
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="{StaticResource HoverBackgroundColor}"/>
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="{StaticResource SelectedBackgroundColor}"/>

    <!-- Стиль заголовка карточки -->
    <Style x:Key="CardHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <!-- Стиль группы полей формы -->
    <Style x:Key="FormGroupStyle" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <!-- Стиль метки поля -->
    <Style x:Key="FormLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

</ResourceDictionary>