<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Кисть для карточек (полупрозрачный белый фон) -->
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" Opacity="0.92"/>

    <!-- Кисть для панели навигации (чуть более плотная) -->
    <SolidColorBrush x:Key="NavBackgroundBrush" Color="#FFFFFF" Opacity="0.96"/>

    <!-- Тень для карточек -->
    <DropShadowEffect x:Key="CardShadow" BlurRadius="8" ShadowDepth="2" Opacity="0.12"/>

    <!-- Скругления -->
    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">4</CornerRadius>
</ResourceDictionary>