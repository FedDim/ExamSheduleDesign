<UserControl x:Class="ExamSheduleDesign.Views.NavigationBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">

    <UserControl.Resources>

        <!-- Стиль заголовка раздела -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#5C5C5C"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
        </Style>

        <!-- Стиль для элементов ListBox (активный пункт, наведение) -->
        <Style x:Key="NavListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,8,8,8"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#E6F2FB"/>
                                <Setter Property="BorderThickness" Value="0,0,0,0"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Border Background="{StaticResource NavBackgroundBrush}"
            CornerRadius="0,12,12,0"
            BorderThickness="0,0,1,0"
            BorderBrush="#E0E0E0">
        <StackPanel Margin="16,24,16,24">
            
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconModern Kind="Calendar" Width="36" Height="36"
                              Foreground="#0078D4"
                              VerticalAlignment="Center"/>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Расписание" FontSize="14" FontWeight="SemiBold"
                   Foreground="#1A1A1A"/>
                    <TextBlock Text="Экзамены v2.0" FontSize="11"
                   Foreground="#5C5C5C"/>
                </StackPanel>
            </StackPanel>

            <Separator Margin="0,8" Height="1" Background="#E0E0E0"/>

            <ListBox x:Name="NavListBox" SelectedValuePath="Tag"
                     Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource NavListBoxItemStyle}">

                <!-- Раздел: Основное -->
                <TextBlock Text="ОСНОВНОЕ" Style="{StaticResource SectionHeaderStyle}" Margin="0,8,0,4"/>

                <ListBoxItem Tag="Main">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconModern Kind="Home" Width="20" Height="20" VerticalAlignment="Center"/>
                        <TextBlock Text="Главная" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </ListBoxItem>

                <ListBoxItem Tag="Schedule">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconModern Kind="CalendarWeek" Width="20" Height="20" VerticalAlignment="Center"/>
                        <TextBlock Text="Таблица расписания" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </ListBoxItem>

                <!-- Раздел: Данные -->
                <TextBlock Text="ДАННЫЕ" Style="{StaticResource SectionHeaderStyle}" Margin="0,8,0,4"/>

                <ListBoxItem Tag="Add">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconModern Kind="Add" Width="20" Height="20" VerticalAlignment="Center"/>
                        <TextBlock Text="Добавление" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </ListBoxItem>

                <ListBoxItem Tag="Edit">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconModern Kind="Edit" Width="20" Height="20" VerticalAlignment="Center"/>
                        <TextBlock Text="Редактирование" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </ListBoxItem>

                <!-- Раздел: Сервис -->
                <TextBlock Text="СЕРВИС" Style="{StaticResource SectionHeaderStyle}" Margin="0,8,0,4"/>

                <ListBoxItem Tag="Dev">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconModern Kind="CodeXml" Width="20" Height="20" VerticalAlignment="Center"/>
                        <TextBlock Text="Разработчик" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
        </StackPanel>
    </Border>
</UserControl>