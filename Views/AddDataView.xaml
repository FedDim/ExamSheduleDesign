<UserControl x:Class="ExamSheduleDesign.Views.AddDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:ExamSheduleDesign.Converters"
             xmlns:viewmodels="clr-namespace:ExamSheduleDesign.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:AddDataViewModel}">

    <UserControl.Resources>
        <converters:RadioButtonConverter x:Key="RadioButtonConverter"/>
        <converters:TabVisibilityConverter x:Key="TabVisibilityConverter"/>

        <Style x:Key="TabButtonStyle" TargetType="RadioButton">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6,6,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="BorderThickness" Value="2,2,2,0"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource HoverBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Вкладки -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <RadioButton GroupName="Tabs" Style="{StaticResource TabButtonStyle}" 
                         IsChecked="{Binding CurrentTab, Converter={StaticResource RadioButtonConverter}, ConverterParameter=Teacher}"
                         Command="{Binding SwitchTabCommand}" CommandParameter="Teacher">
                Преподаватель
            </RadioButton>
            <RadioButton GroupName="Tabs" Style="{StaticResource TabButtonStyle}" 
                         IsChecked="{Binding CurrentTab, Converter={StaticResource RadioButtonConverter}, ConverterParameter=Discipline}"
                         Command="{Binding SwitchTabCommand}" CommandParameter="Discipline">
                Дисциплина
            </RadioButton>
            <RadioButton GroupName="Tabs" Style="{StaticResource TabButtonStyle}" 
                         IsChecked="{Binding CurrentTab, Converter={StaticResource RadioButtonConverter}, ConverterParameter=Group}"
                         Command="{Binding SwitchTabCommand}" CommandParameter="Group">
                Группа
            </RadioButton>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ЛЕВАЯ КОЛОНКА: форма добавления -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                <StackPanel>
                    <!-- Заголовок для преподавателя -->
                    <TextBlock Style="{StaticResource CardHeaderStyle}" Margin="0,0,0,16"
                               Visibility="{Binding CurrentTab, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=Teacher}"
                               Text="Добавить преподавателя"/>
                    <!-- Заголовок для дисциплины -->
                    <TextBlock Style="{StaticResource CardHeaderStyle}" Margin="0,0,0,16"
                               Visibility="{Binding CurrentTab, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=Discipline}"
                               Text="Добавить дисциплину"/>
                    <!-- Заголовок для группы -->
                    <TextBlock Style="{StaticResource CardHeaderStyle}" Margin="0,0,0,16"
                               Visibility="{Binding CurrentTab, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=Group}"
                               Text="Добавить группу"/>

                    <!-- Форма для преподавателя -->
                    <StackPanel Visibility="{Binding CurrentTab, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=Teacher}">
                        <StackPanel Style="{StaticResource FormGroupStyle}">
                            <TextBlock Style="{StaticResource FormLabelStyle}">ФИО преподавателя</TextBlock>
                            <TextBox Text="{Binding NewTeacherFullName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <Button Content="Добавить" Command="{Binding AddTeacherCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <!-- Форма для дисциплины -->
                    <StackPanel Visibility="{Binding CurrentTab, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=Discipline}">
                        <StackPanel Style="{StaticResource FormGroupStyle}">
                            <TextBlock Style="{StaticResource FormLabelStyle}">Название дисциплины</TextBlock>
                            <TextBox Text="{Binding NewDisciplineName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <Button Content="Добавить" Command="{Binding AddDisciplineCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <!-- Форма для группы -->
                    <StackPanel Visibility="{Binding CurrentTab, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=Group}">
                        <StackPanel Style="{StaticResource FormGroupStyle}">
                            <TextBlock Style="{StaticResource FormLabelStyle}">Название группы</TextBlock>
                            <TextBox Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource FormGroupStyle}">
                            <TextBlock Style="{StaticResource FormLabelStyle}">Отделение</TextBlock>
                            <ComboBox ItemsSource="{Binding DepartmentOptions}" SelectedItem="{Binding NewGroupDepartment}" Width="200" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <Button Content="Добавить" Command="{Binding AddGroupCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ПРАВАЯ КОЛОНКА: таблица существующих записей -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <!-- Заголовки таблиц -->
                    <TextBlock Style="{StaticResource CardHeaderStyle}" Margin="0,0,0,16"
                               Visibility="{Binding CurrentTab, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=Teacher}"
                               Text="Существующие преподаватели"/>
                    <TextBlock Style="{StaticResource CardHeaderStyle}" Margin="0,0,0,16"
                               Visibility="{Binding CurrentTab, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=Discipline}"
                               Text="Существующие дисциплины"/>
                    <TextBlock Style="{StaticResource CardHeaderStyle}" Margin="0,0,0,16"
                               Visibility="{Binding CurrentTab, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=Group}"
                               Text="Существующие группы"/>

                    <!-- Таблица преподавателей -->
                    <DataGrid ItemsSource="{Binding Teachers}" AutoGenerateColumns="False" HeadersVisibility="Column" RowHeight="35"
                              Visibility="{Binding CurrentTab, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=Teacher}"
                              Style="{StaticResource DataGridStyle}" Margin="0,0,0,12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Width="50" Binding="{Binding Id}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="ФИО" Width="*" Binding="{Binding FullName}" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Таблица дисциплин -->
                    <DataGrid ItemsSource="{Binding Disciplines}" AutoGenerateColumns="False" HeadersVisibility="Column" RowHeight="35"
                              Visibility="{Binding CurrentTab, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=Discipline}"
                              Style="{StaticResource DataGridStyle}" Margin="0,0,0,12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Width="50" Binding="{Binding Id}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Название" Width="*" Binding="{Binding Name}" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Таблица групп -->
                    <DataGrid ItemsSource="{Binding Groups}" AutoGenerateColumns="False" HeadersVisibility="Column" RowHeight="35"
                              Visibility="{Binding CurrentTab, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=Group}"
                              Style="{StaticResource DataGridStyle}" Margin="0,0,0,12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Width="50" Binding="{Binding Id}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Название" Width="120" Binding="{Binding Name}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Отделение" Width="*" Binding="{Binding Department}" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>