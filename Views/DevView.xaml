<UserControl x:Class="ExamSheduleDesign.Views.DevView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:ExamSheduleDesign.ViewModels"
             mc:Ignorable="d"
             xmlns:converters="clr-namespace:ExamSheduleDesign.Converters"
             d:DataContext="{d:DesignInstance Type=viewmodels:DevViewModel}">

    <UserControl.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель: управление -->
        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,16,0">
            <StackPanel>
                <TextBlock Style="{StaticResource CardHeaderStyle}">Генерация экзаменов</TextBlock>

                <StackPanel Style="{StaticResource FormGroupStyle}">
                    <TextBlock Style="{StaticResource FormLabelStyle}">Количество для генерации</TextBlock>
                    <TextBox Text="{Binding GenerationCount, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left"/>
                </StackPanel>

                <Button Content="Сгенерировать" Command="{Binding GenerateCommand}" Style="{StaticResource PrimaryButtonStyle}" 
                        IsEnabled="{Binding IsGenerating, Converter={StaticResource InverseBooleanConverter}}" Width="150" Margin="0,0,0,12"/>

                <Button Content="Удалить сгенерированные" Command="{Binding ClearGeneratedCommand}" Style="{StaticResource DangerButtonStyle}" Width="200" Margin="0,0,0,12"/>

                <Separator Margin="0,12,0,12"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Ellipse Width="12" Height="12" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding StatusText}" FontStyle="Italic" Foreground="{StaticResource SecondaryTextBrush}"/>
                </StackPanel>

                <!-- Простая статистика -->
                <TextBlock Style="{StaticResource CardHeaderStyle}" FontSize="14" Margin="0,8,0,8">Информация</TextBlock>
                <TextBlock>Преподавателей: <Run Text="{Binding TeachersCount, Mode=OneWay}"/></TextBlock>
                <TextBlock>Дисциплин: <Run Text="{Binding DisciplinesCount, Mode=OneWay}"/></TextBlock>
                <TextBlock>Групп: <Run Text="{Binding GroupsCount, Mode=OneWay}"/></TextBlock>

                <Button Content="Тест загрузки экзаменов" Command="{Binding TestLoadExamsCommand}" 
        Style="{StaticResource SecondaryButtonStyle}" Margin="0,12,0,0"/>
                
            </StackPanel>
        </Border>

        <!-- Правая панель: список сгенерированных экзаменов -->
        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource CardHeaderStyle}">Сгенерированные экзамены</TextBlock>
                <ListView ItemsSource="{Binding GeneratedExams}" Height="400" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Дата" Width="80" DisplayMemberBinding="{Binding Date, StringFormat=dd.MM.yyyy}"/>
                            <GridViewColumn Header="Время" Width="60" DisplayMemberBinding="{Binding Time}"/>
                            <GridViewColumn Header="Тип" Width="80" DisplayMemberBinding="{Binding Type}"/>
                            <GridViewColumn Header="Преподаватель 1" Width="120" DisplayMemberBinding="{Binding Teacher1.Name}"/>
                            <GridViewColumn Header="Преподаватель 2" Width="120" DisplayMemberBinding="{Binding Teacher2.Name}"/>
                            <GridViewColumn Header="Дисциплина" Width="120" DisplayMemberBinding="{Binding Discipline.Name}"/>
                            <GridViewColumn Header="Группа" Width="80" DisplayMemberBinding="{Binding Group.Name}"/>
                            <GridViewColumn Header="Аудитория" Width="70" DisplayMemberBinding="{Binding Classroom}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>