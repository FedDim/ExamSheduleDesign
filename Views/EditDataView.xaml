<UserControl x:Class="ExamSheduleDesign.Views.EditDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:ExamSheduleDesign.Converters"
             xmlns:viewmodels="clr-namespace:ExamSheduleDesign.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:EditDataViewModel}">

    <UserControl.Resources>
        <converters:RadioButtonConverter x:Key="RadioButtonConverter"/>
        <converters:TabVisibilityConverter x:Key="TabVisibilityConverter"/>
        <converters:BooleanConverter x:Key="BooleanConverter"/>

        <Style x:Key="TabButtonStyle" TargetType="ToggleButton">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6,6,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="BorderThickness" Value="2,2,2,0"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource HoverBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="#F9F9F9"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="35"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="CellStyle" Value="{StaticResource DataGridCellStyle}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <ToggleButton Style="{StaticResource TabButtonStyle}" 
                          IsChecked="{Binding CurrentTab, Converter={StaticResource RadioButtonConverter}, ConverterParameter=Teacher}"
                          Command="{Binding SwitchTabCommand}" CommandParameter="Teacher">
                Преподаватели
            </ToggleButton>
            <ToggleButton Style="{StaticResource TabButtonStyle}" 
                          IsChecked="{Binding CurrentTab, Converter={StaticResource RadioButtonConverter}, ConverterParameter=Discipline}"
                          Command="{Binding SwitchTabCommand}" CommandParameter="Discipline">
                Дисциплины
            </ToggleButton>
            <ToggleButton Style="{StaticResource TabButtonStyle}" 
                          IsChecked="{Binding CurrentTab, Converter={StaticResource RadioButtonConverter}, ConverterParameter=Group}"
                          Command="{Binding SwitchTabCommand}" CommandParameter="Group">
                Группы
            </ToggleButton>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <Grid>
                <!-- Таблица преподавателей -->
                <DataGrid ItemsSource="{Binding Teachers}" AutoGenerateColumns="False" HeadersVisibility="Column" RowHeight="35"
                          Visibility="{Binding CurrentTab, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=Teacher}"
                          Style="{StaticResource DataGridStyle}" CanUserAddRows="False" CanUserDeleteRows="False"
                          SelectedItem="{Binding SelectedTeacher}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Width="50" Binding="{Binding Id}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="ФИО" Width="*" Binding="{Binding Name}" IsReadOnly="False"/>
                        <DataGridTextColumn Header="Аудитория" Width="100" Binding="{Binding Classroom}" IsReadOnly="False"/>
                        <DataGridTextColumn Header="Корпус" Width="80" Binding="{Binding AcademicBuilding}" IsReadOnly="False"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Таблица дисциплин -->
                <DataGrid ItemsSource="{Binding Disciplines}" AutoGenerateColumns="False" HeadersVisibility="Column" RowHeight="35"
                          Visibility="{Binding CurrentTab, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=Discipline}"
                          Style="{StaticResource DataGridStyle}" CanUserAddRows="False" CanUserDeleteRows="False"
                          SelectedItem="{Binding SelectedDiscipline}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Width="50" Binding="{Binding Id}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Полное название" Width="*" Binding="{Binding FullName}" IsReadOnly="False"/>
                        <DataGridTextColumn Header="Сокр. 12" Width="80" Binding="{Binding ShortName12}" IsReadOnly="False"/>
                        <DataGridTextColumn Header="Сокр. 9" Width="80" Binding="{Binding ShortName9}" IsReadOnly="False"/>
                        <DataGridTextColumn Header="Сокр. 5" Width="80" Binding="{Binding ShortName5}" IsReadOnly="False"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Таблица групп -->
                <DataGrid ItemsSource="{Binding Groups}" AutoGenerateColumns="False" HeadersVisibility="Column" RowHeight="35"
                          Visibility="{Binding CurrentTab, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=Group}"
                          Style="{StaticResource DataGridStyle}" CanUserAddRows="False" CanUserDeleteRows="False"
                          SelectedItem="{Binding SelectedGroup}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Width="50" Binding="{Binding Id}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Название" Width="*" Binding="{Binding Name}" IsReadOnly="False"/>
                        <DataGridTextColumn Header="Отделение" Width="120" Binding="{Binding Department}" IsReadOnly="False"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="12,12" Margin="0,16,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <!-- Кнопка удаления для преподавателей -->
                    <Button Content="Удалить выбранное" Command="{Binding DeleteCurrentCommand}" 
                            Style="{StaticResource DangerButtonStyle}"
                            IsEnabled="{Binding CanDeleteTeacher}"
                            Visibility="{Binding CurrentTab, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=Teacher}"/>

                    <!-- Кнопка удаления для дисциплин -->
                    <Button Content="Удалить выбранное" Command="{Binding DeleteCurrentCommand}" 
                            Style="{StaticResource DangerButtonStyle}"
                            IsEnabled="{Binding CanDeleteDiscipline}"
                            Visibility="{Binding CurrentTab, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=Discipline}"/>

                    <!-- Кнопка удаления для групп -->
                    <Button Content="Удалить выбранное" Command="{Binding DeleteCurrentCommand}" 
                            Style="{StaticResource DangerButtonStyle}"
                            IsEnabled="{Binding CanDeleteGroup}"
                            Visibility="{Binding CurrentTab, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=Group}"/>
                </StackPanel>
                <Button Content="Сохранить изменения" Command="{Binding SaveCurrentCommand}" 
                        Style="{StaticResource PrimaryButtonStyle}" Width="200" Height="36" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>